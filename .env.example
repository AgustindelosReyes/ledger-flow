# ─────────────────────────────────────────────────────────────────────────────
# LedgerFlow — environment variables.
# Copy to `.env` and adjust. Every variable is validated at startup
# (src/config/env.ts): if a required one is missing or malformed, the app
# refuses to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── PostgreSQL ──
# Used by docker-compose to create the database.
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ledgerflow
# Port published on the host (change it if 5432 is taken).
POSTGRES_HOST_PORT=5432
# [required] Connection used by the app and by Prisma when running outside Docker.
# Inside docker-compose it is overridden to point at the `postgres` service.
DATABASE_URL=postgresql://ledgerflow:change-me-local-only@localhost:5432/ledgerflow?schema=public

# ── Redis (BullMQ queues and fiscal simulator state) ──
# [required]
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional; leave empty if Redis requires no authentication.
REDIS_PASSWORD=
# Redis logical database index (0-15). Index 15 is reserved for the e2e tests.
REDIS_DB=0
# Port published on the host (change it if 6379 is taken).
REDIS_HOST_PORT=6379

# ── Security ──
# [required] Secret shared with the gateway to sign webhooks (HMAC-SHA256).
# At least 32 characters. Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=replace-with-output-of-openssl-rand-hex-32
# Tolerance window for the signed timestamp (replay protection).
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# [required] API key for the admin, ledger and operations endpoints.
# At least 24 characters. Generate with: openssl rand -hex 24
ADMIN_API_KEY=replace-with-output-of-openssl-rand-hex-24

# ── Fiscal invoicing ──
FISCAL_POINT_OF_SALE=1
# Maximum time to wait for the fiscal authority before aborting an attempt.
FISCAL_REQUEST_TIMEOUT_MS=2000

# ── Fiscal authority simulator (ARCA/AFIP) ──
# Probability [0..1] that a request fails with a 503 or a timeout.
FISCAL_SIMULATOR_FAILURE_RATE=0.3
FISCAL_SIMULATOR_MIN_LATENCY_MS=50
FISCAL_SIMULATOR_MAX_LATENCY_MS=800

# ── Invoice queue (BullMQ) ──
# Total attempts before the invoice is moved to the Dead Letter Queue.
INVOICE_JOB_ATTEMPTS=5
# Base of the exponential backoff: delay = base * 2^(attempt - 1).
INVOICE_JOB_BACKOFF_MS=1000
INVOICE_WORKER_CONCURRENCY=5
# Set to false to deploy API-only instances, separate from the ones that process the queue.
INVOICE_WORKER_ENABLED=true

# ── Outbox ──
# How often the relay publishes pending events to BullMQ.
OUTBOX_POLL_INTERVAL_MS=1000
# Maximum number of events published per iteration.
OUTBOX_BATCH_SIZE=50
# Attempts before an unpublishable event (unknown type or corrupt payload) is marked FAILED.
# Infrastructure failures (Redis down) are retried without limit.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RELAY_ENABLED=true
