# ─────────────────────────────────────────────────────────────────────────────
# LedgerFlow — variables de entorno.
# Copiar a `.env` y ajustar. Todas se validan al arrancar (src/config/env.ts):
# si falta una obligatoria o tiene formato inválido, la app no inicia.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ──
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── PostgreSQL ──
# Usadas por docker-compose para crear la base.
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ledgerflow
# Puerto publicado en el host (cambiar si 5432 está ocupado).
POSTGRES_HOST_PORT=5432
# [obligatoria] Conexión usada por la app y por Prisma al correr fuera de Docker.
# Dentro de docker-compose se sobreescribe para apuntar al servicio `postgres`.
DATABASE_URL=postgresql://ledgerflow:change-me-local-only@localhost:5432/ledgerflow?schema=public

# ── Redis (BullMQ + idempotencia) ──
# [obligatorias]
REDIS_HOST=localhost
REDIS_PORT=6379
# Opcional; dejar vacío si Redis no requiere autenticación.
REDIS_PASSWORD=
# Índice de base lógica de Redis (0-15).
REDIS_DB=0
# Puerto publicado en el host (cambiar si 6379 está ocupado).
REDIS_HOST_PORT=6379

# ── Seguridad ──
# [obligatoria] Secreto compartido con la pasarela para firmar webhooks (HMAC-SHA256).
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=replace-with-output-of-openssl-rand-hex-32
# Ventana de tolerancia del timestamp firmado (protección anti-replay).
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# [obligatoria] API key de los endpoints administrativos (inspección/reencolado de DLQ).
# Mínimo 24 caracteres. Generar con: openssl rand -hex 24
ADMIN_API_KEY=replace-with-output-of-openssl-rand-hex-24

# ── Facturación fiscal ──
FISCAL_POINT_OF_SALE=1
# Tiempo máximo de espera por respuesta del ente fiscal antes de abortar el intento.
FISCAL_REQUEST_TIMEOUT_MS=2000

# ── Simulador de ente fiscal (ARCA/AFIP) ──
# Probabilidad [0..1] de que una solicitud falle con 503 o timeout.
FISCAL_SIMULATOR_FAILURE_RATE=0.3
FISCAL_SIMULATOR_MIN_LATENCY_MS=50
FISCAL_SIMULATOR_MAX_LATENCY_MS=800

# ── Cola de facturación (BullMQ) ──
# Intentos totales antes de mover el job a la Dead Letter Queue.
INVOICE_JOB_ATTEMPTS=5
# Base del backoff exponencial: espera = base * 2^(intento-1).
INVOICE_JOB_BACKOFF_MS=1000
INVOICE_WORKER_CONCURRENCY=5
# Permite desplegar instancias solo-API (false) separadas de las que procesan la cola.
INVOICE_WORKER_ENABLED=true

# ── Outbox ──
# Frecuencia con la que el relay publica en BullMQ los eventos pendientes.
OUTBOX_POLL_INTERVAL_MS=1000
# Máximo de eventos publicados por iteración.
OUTBOX_BATCH_SIZE=50
# Intentos antes de marcar como FAILED un evento impublicable (tipo desconocido o payload
# corrupto). Las fallas de infraestructura (Redis caído) se reintentan sin límite.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RELAY_ENABLED=true
