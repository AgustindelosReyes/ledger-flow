{
  "name": "ledger-flow",
  "version": "0.1.0",
  "description": "Motor asíncrono de facturación electrónica y conciliación de pagos",
  "author": "Agustin",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:cov": "pnpm test --coverage",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.config.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
