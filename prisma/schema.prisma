// LedgerFlow — data model.
//
// Conventions:
//  - UUID v7 primary keys (time-ordered: good locality in B-tree indexes).
//  - Money as NUMERIC(19,4); never float.
//  - The invariants Prisma cannot express (CHECKs, immutability triggers and the
//    double-entry balance trigger) live in the SQL migration `ledger_integrity_constraints`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum PaymentProvider {
  MERCADOPAGO
  STRIPE

  @@map("payment_provider")
}

enum WebhookEventStatus {
  /// Produced business effects (payment + journal entry + invoice request).
  PROCESSED
  /// Valid event with no accounting effect (unsupported type); kept for audit.
  IGNORED

  @@map("webhook_event_status")
}

enum PaymentStatus {
  APPROVED
  REFUNDED

  @@map("payment_status")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("ledger_account_type")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

enum LedgerTransactionType {
  PAYMENT_CAPTURE
  PAYMENT_REFUND

  @@map("ledger_transaction_type")
}

enum InvoiceStatus {
  /// Created in the same transaction as the payment; not yet taken by the worker.
  PENDING
  /// A worker is processing it against the fiscal authority.
  PROCESSING
  /// Authorized: it has a number and a CAE.
  ISSUED
  /// Retries exhausted; the job is in the DLQ awaiting a manual requeue.
  DEAD_LETTERED

  @@map("invoice_status")
}

enum InvoiceType {
  A
  B
  C

  @@map("invoice_type")
}

enum InvoiceAttemptOutcome {
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE

  @@map("invoice_attempt_outcome")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  /// Unpublishable (unknown type or corrupt payload) after exhausting its attempts. The
  /// relay stops picking it up; it requires manual intervention.
  FAILED

  @@map("outbox_status")
}

// ──────────────────────── Webhook ingestion ────────────────────────

/// Record of every accepted event. Its unique constraint is the source of truth for
/// idempotency: N concurrent deliveries of the same event compete for a single INSERT.
model WebhookEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  provider      PaymentProvider
  /// Idempotency key issued by the gateway.
  eventId       String             @map("event_id") @db.VarChar(128)
  eventType     String             @map("event_type") @db.VarChar(64)
  /// SHA-256 of the raw body: detects reuse of the same key with a different payload.
  payloadHash   String             @map("payload_hash") @db.Char(64)
  payload       Json
  status        WebhookEventStatus
  correlationId String             @map("correlation_id") @db.VarChar(64)
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)

  payment Payment?

  @@unique([provider, eventId], map: "webhook_events_provider_event_id_key")
  @@index([correlationId])
  @@map("webhook_events")
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  /// Event that originated the payment (Webhook -> Payment traceability).
  webhookEventId    String          @unique @map("webhook_event_id") @db.Uuid
  provider          PaymentProvider
  /// Payment identifier in the gateway. Second line of defense against duplicates:
  /// two different events about the same payment cannot create two charges.
  externalPaymentId String          @map("external_payment_id") @db.VarChar(128)
  status            PaymentStatus   @default(APPROVED)
  amount            Decimal         @db.Decimal(19, 4)
  currency          String          @db.Char(3)
  payerName         String?         @map("payer_name") @db.VarChar(200)
  payerTaxId        String?         @map("payer_tax_id") @db.VarChar(20)
  description       String?         @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  webhookEvent       WebhookEvent        @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)
  ledgerTransactions LedgerTransaction[]
  invoice            Invoice?

  @@unique([provider, externalPaymentId], map: "payments_provider_external_payment_id_key")
  @@index([createdAt])
  @@map("payments")
}

// ───────────────────── General ledger (double entry) ─────────────────────

/// Chart of accounts. Reference data seeded by migration.
model LedgerAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  code          String            @unique @db.VarChar(64)
  name          String            @db.VarChar(200)
  type          LedgerAccountType
  /// Side on which the account increases; it defines the sign of the balance.
  normalBalance EntryDirection    @map("normal_balance")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

/// Journal entry (header). Append-only: it is corrected with a reversing entry, never
/// with UPDATE/DELETE (blocked by trigger).
model LedgerTransaction {
  id            String                @id @default(uuid(7)) @db.Uuid
  paymentId     String                @map("payment_id") @db.Uuid
  type          LedgerTransactionType
  description   String                @db.VarChar(500)
  correlationId String                @map("correlation_id") @db.VarChar(64)
  /// Entry that this one reverses, if any. Unique: an entry is reversed at most once.
  reversesId    String?               @unique @map("reverses_id") @db.Uuid
  postedAt      DateTime              @default(now()) @map("posted_at") @db.Timestamptz(3)

  payment    Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  entries    LedgerEntry[]

  /// A payment admits a single entry of each type (capture, refund).
  @@unique([paymentId, type], map: "ledger_transactions_payment_id_type_key")
  @@index([postedAt])
  @@map("ledger_transactions")
}

/// Journal entry line. `amount` is always positive; `direction` gives the sign.
/// Invariant (trigger deferred to COMMIT): per entry and currency, Σ debits = Σ credits.
model LedgerEntry {
  id            String         @id @default(uuid(7)) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  amount        Decimal        @db.Decimal(19, 4)
  currency      String         @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  /// Covers the balance calculation and the per-currency statement of an account, in order.
  @@index([accountId, currency, id])
  @@map("ledger_entries")
}

// ───────────────────────── Fiscal invoicing ─────────────────────────

model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// Unique: a payment produces exactly one invoice.
  paymentId     String        @unique @map("payment_id") @db.Uuid
  status        InvoiceStatus @default(PENDING)
  type          InvoiceType
  pointOfSale   Int           @map("point_of_sale")
  /// Number assigned by the fiscal authority when it authorizes the invoice.
  number        Int?
  cae           String?       @db.VarChar(14)
  caeExpiresAt  DateTime?     @map("cae_expires_at") @db.Date
  netAmount     Decimal       @map("net_amount") @db.Decimal(19, 4)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(19, 4)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(19, 4)
  currency      String        @db.Char(3)
  attemptCount  Int           @default(0) @map("attempt_count")
  lastError     String?       @map("last_error") @db.VarChar(1000)
  /// Optimistic lock: every state transition does `WHERE version = ?` and increments it.
  version       Int           @default(0)
  correlationId String        @map("correlation_id") @db.VarChar(64)
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment     Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempts    InvoiceAttempt[]
  corrections InvoiceCorrection[]

  /// The fiscal number cannot repeat (NULLs do not collide while the invoice is not issued).
  @@unique([pointOfSale, type, number], map: "invoices_point_of_sale_type_number_key")
  /// Operational monitoring: invoices stuck, by status and age.
  @@index([status, createdAt])
  @@map("invoices")
}

/// Append-only log of every attempt against the fiscal authority (Job -> Invoice trace).
model InvoiceAttempt {
  id            String                @id @default(uuid(7)) @db.Uuid
  invoiceId     String                @map("invoice_id") @db.Uuid
  jobId         String                @map("job_id") @db.VarChar(128)
  attemptNumber Int                   @map("attempt_number")
  outcome       InvoiceAttemptOutcome
  /// HTTP status returned by the fiscal authority; NULL if there was no response (timeout).
  httpStatus    Int?                  @map("http_status")
  /// Body of the fiscal authority response (authorization or rejection detail).
  response      Json?
  errorCode     String?               @map("error_code") @db.VarChar(64)
  errorMessage  String?               @map("error_message") @db.VarChar(1000)
  durationMs    Int                   @map("duration_ms")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
  @@map("invoice_attempts")
}

/// Append-only log of manual corrections of fiscal data, applied when an invoice is
/// requeued from the DLQ. It answers who changed what, when and why.
model InvoiceCorrection {
  id            String   @id @default(uuid(7)) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  field         String   @db.VarChar(64)
  previousValue String?  @map("previous_value") @db.VarChar(200)
  newValue      String   @map("new_value") @db.VarChar(200)
  reason        String?  @db.VarChar(500)
  /// correlationId of the admin request that applied the correction.
  correlationId String   @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
  @@map("invoice_corrections")
}

// ─────────────────────── Transactional outbox ───────────────────────

/// Messages to publish to BullMQ, written in the same transaction as the payment. Avoids
/// the Postgres/Redis dual write: if the transaction commits, the job is enqueued at least once.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String       @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String       @map("correlation_id") @db.VarChar(64)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)

  /// The relay reads `WHERE status = 'PENDING' ORDER BY created_at ... FOR UPDATE SKIP LOCKED`.
  @@index([status, createdAt])
  @@map("outbox_events")
}
