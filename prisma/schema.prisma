// LedgerFlow — modelo de datos.
//
// Convenciones:
//  - PKs UUID v7 (ordenables por tiempo: buena localidad en índices B-tree).
//  - Dinero en NUMERIC(19,4); nunca float.
//  - Las invariantes que Prisma no puede expresar (CHECKs, triggers de inmutabilidad y de
//    balance de doble partida) viven en la migración SQL `ledger_integrity_constraints`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum PaymentProvider {
  MERCADOPAGO
  STRIPE

  @@map("payment_provider")
}

enum WebhookEventStatus {
  /// Generó efectos de negocio (pago + asiento + solicitud de factura).
  PROCESSED
  /// Evento válido pero sin efecto contable (tipo no soportado); se conserva para auditoría.
  IGNORED

  @@map("webhook_event_status")
}

enum PaymentStatus {
  APPROVED
  REFUNDED

  @@map("payment_status")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("ledger_account_type")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

enum LedgerTransactionType {
  PAYMENT_CAPTURE
  PAYMENT_REFUND

  @@map("ledger_transaction_type")
}

enum InvoiceStatus {
  /// Creada en la misma transacción que el pago; aún no tomada por el worker.
  PENDING
  /// Un worker la está tramitando ante el ente fiscal.
  PROCESSING
  /// Autorizada: tiene número y CAE.
  ISSUED
  /// Agotó reintentos; el job está en la DLQ a la espera de reencolado manual.
  DEAD_LETTERED

  @@map("invoice_status")
}

enum InvoiceType {
  A
  B
  C

  @@map("invoice_type")
}

enum InvoiceAttemptOutcome {
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE

  @@map("invoice_attempt_outcome")
}

enum OutboxStatus {
  PENDING
  PUBLISHED

  @@map("outbox_status")
}

// ──────────────────────── Ingesta de webhooks ────────────────────────

/// Registro de cada evento aceptado. Su constraint única es la fuente de verdad de la
/// idempotencia: N entregas concurrentes del mismo evento compiten por un único INSERT.
model WebhookEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  provider      PaymentProvider
  /// Clave de idempotencia emitida por la pasarela.
  eventId       String             @map("event_id") @db.VarChar(128)
  eventType     String             @map("event_type") @db.VarChar(64)
  /// SHA-256 del cuerpo crudo: detecta reutilización de la misma clave con otro payload.
  payloadHash   String             @map("payload_hash") @db.Char(64)
  payload       Json
  status        WebhookEventStatus
  correlationId String             @map("correlation_id") @db.VarChar(64)
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)

  payment Payment?

  @@unique([provider, eventId], map: "webhook_events_provider_event_id_key")
  @@index([correlationId])
  @@map("webhook_events")
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  /// Evento que originó el pago (trazabilidad Webhook -> Pago).
  webhookEventId    String          @unique @map("webhook_event_id") @db.Uuid
  provider          PaymentProvider
  /// Identificador del pago en la pasarela. Segunda línea de defensa contra duplicados:
  /// dos eventos distintos sobre el mismo pago no pueden crear dos cobros.
  externalPaymentId String          @map("external_payment_id") @db.VarChar(128)
  status            PaymentStatus   @default(APPROVED)
  amount            Decimal         @db.Decimal(19, 4)
  currency          String          @db.Char(3)
  payerName         String?         @map("payer_name") @db.VarChar(200)
  payerTaxId        String?         @map("payer_tax_id") @db.VarChar(20)
  description       String?         @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  webhookEvent       WebhookEvent        @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)
  ledgerTransactions LedgerTransaction[]
  invoice            Invoice?

  @@unique([provider, externalPaymentId], map: "payments_provider_external_payment_id_key")
  @@index([createdAt])
  @@map("payments")
}

// ───────────────────── Libro mayor (doble partida) ─────────────────────

/// Plan de cuentas. Datos de referencia sembrados por migración.
model LedgerAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  code          String            @unique @db.VarChar(64)
  name          String            @db.VarChar(200)
  type          LedgerAccountType
  /// Lado en el que la cuenta aumenta; define el signo del saldo.
  normalBalance EntryDirection    @map("normal_balance")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

/// Asiento contable (cabecera). Append-only: se corrige con un asiento de reversa, nunca
/// con UPDATE/DELETE (bloqueados por trigger).
model LedgerTransaction {
  id            String                @id @default(uuid(7)) @db.Uuid
  paymentId     String                @map("payment_id") @db.Uuid
  type          LedgerTransactionType
  description   String                @db.VarChar(500)
  correlationId String                @map("correlation_id") @db.VarChar(64)
  /// Asiento que este revierte, si aplica. Único: un asiento se revierte a lo sumo una vez.
  reversesId    String?               @unique @map("reverses_id") @db.Uuid
  postedAt      DateTime              @default(now()) @map("posted_at") @db.Timestamptz(3)

  payment    Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  entries    LedgerEntry[]

  /// Un pago admite un único asiento de cada tipo (captura, reembolso).
  @@unique([paymentId, type], map: "ledger_transactions_payment_id_type_key")
  @@index([postedAt])
  @@map("ledger_transactions")
}

/// Línea de asiento. `amount` siempre positivo; el signo lo da `direction`.
/// Invariante (trigger diferido al COMMIT): por asiento y moneda, Σ débitos = Σ créditos.
model LedgerEntry {
  id            String         @id @default(uuid(7)) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  amount        Decimal        @db.Decimal(19, 4)
  currency      String         @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  /// Cubre el cálculo de saldo y el extracto de una cuenta por moneda, en orden cronológico.
  @@index([accountId, currency, id])
  @@map("ledger_entries")
}

// ───────────────────────── Facturación fiscal ─────────────────────────

model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// Único: un pago genera exactamente un comprobante.
  paymentId     String        @unique @map("payment_id") @db.Uuid
  status        InvoiceStatus @default(PENDING)
  type          InvoiceType
  pointOfSale   Int           @map("point_of_sale")
  /// Numeración asignada por el ente fiscal al autorizar.
  number        Int?
  cae           String?       @db.VarChar(14)
  caeExpiresAt  DateTime?     @map("cae_expires_at") @db.Date
  netAmount     Decimal       @map("net_amount") @db.Decimal(19, 4)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(19, 4)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(19, 4)
  currency      String        @db.Char(3)
  attemptCount  Int           @default(0) @map("attempt_count")
  lastError     String?       @map("last_error") @db.VarChar(1000)
  /// Bloqueo optimista: toda transición de estado hace `WHERE version = ?` e incrementa.
  version       Int           @default(0)
  correlationId String        @map("correlation_id") @db.VarChar(64)
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment  Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempts InvoiceAttempt[]

  /// La numeración fiscal no puede repetirse (NULLs no colisionan mientras no se emite).
  @@unique([pointOfSale, type, number], map: "invoices_point_of_sale_type_number_key")
  /// Monitoreo operativo: comprobantes trabados por estado y antigüedad.
  @@index([status, createdAt])
  @@map("invoices")
}

/// Bitácora append-only de cada intento contra el ente fiscal (trazabilidad Job -> Comprobante).
model InvoiceAttempt {
  id            String                @id @default(uuid(7)) @db.Uuid
  invoiceId     String                @map("invoice_id") @db.Uuid
  jobId         String                @map("job_id") @db.VarChar(128)
  attemptNumber Int                   @map("attempt_number")
  outcome       InvoiceAttemptOutcome
  errorCode     String?               @map("error_code") @db.VarChar(64)
  errorMessage  String?               @map("error_message") @db.VarChar(1000)
  durationMs    Int                   @map("duration_ms")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
  @@map("invoice_attempts")
}

// ─────────────────────── Transactional outbox ───────────────────────

/// Mensajes a publicar en BullMQ, escritos en la misma transacción que el pago. Evita el
/// dual-write Postgres/Redis: si la transacción confirma, el job se encola al menos una vez.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String       @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String       @map("correlation_id") @db.VarChar(64)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)

  /// El relay lee `WHERE status = 'PENDING' ORDER BY created_at ... FOR UPDATE SKIP LOCKED`.
  @@index([status, createdAt])
  @@map("outbox_events")
}
